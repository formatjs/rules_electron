load("@rules_electron//electron:defs.bzl", "electron_runtime")

electron_runtime(
    name = "runtime",
    binary = "electron",
    files = {
        path: path
        for path in glob(
            [
                "*",
            ],
            # Privilege bits are assigned only by the installer.
            exclude = [
                "electron",
                "BUILD.bazel",
                "MODULE.bazel",
                "WORKSPACE",
                "WORKSPACE.bazel",
            ],
        ) + ["locales/en-US.pak"]
    },
    visibility = ["//visibility:public"],
)
