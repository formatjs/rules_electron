load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_electron//electron:appimage.bzl", "electron_appimage")
load("@rules_electron//electron:archive.bzl", "electron_archive")
load("@rules_electron//electron:asar.bzl", "electron_asar")
load("@rules_electron//electron:defs.bzl", "electron_runtime")
load("@rules_electron//electron:files.bzl", "electron_files")
load("@rules_electron//electron:linux.bzl", "electron_deb", "electron_rpm")
load("@rules_electron//electron:matching.bzl", "electron_file_matcher")
load("@rules_electron//electron:msix.bzl", "electron_msix")
load("@rules_electron//electron:npm.bzl", "electron_npm_package", "electron_npm_tree")
load("@rules_electron//electron:nsis.bzl", "electron_nsis", "electron_nsis_tool")
load("@rules_electron//electron:update.bzl", "electron_update_config", "electron_update_feed")
load("@rules_electron//electron:windows.bzl", "electron_windows_resource_tool")
load("@rules_python//python:defs.bzl", "py_test")
load("//tools:cross_bundle.bzl", "cross_smoke_bundle")
load("//tools:icon.bzl", "example_icon")
load("//tools:msix_fixture.bzl", "msix_fixture_app")
load(":desktop_app.bzl", "desktop_app")

example_icon(name = "example_icon")

example_icon(
    name = "document_icon",
    format = "png",
    gray = 83,
)

electron_files(
    name = "empty_resources",
    directories = ["empty"],
)

electron_npm_package(
    name = "native_package",
    srcs = {
        "native-package/index.cjs": "index.cjs",
        ":native_addon": "addon.node",
    },
    package_json = "native-package/package.json",
)

electron_npm_tree(
    name = "workspace_npm",
    packages = {":native_package": "node_modules/example-native"},
)

example_icon(
    name = "example_windows_icon",
    format = "ico",
)

example_icon(
    name = "example_document_icon",
    format = "ico",
    gray = 83,
)

example_icon(
    name = "example_installer_icon",
    format = "ico",
    gray = 73,
)

example_icon(
    name = "example_uninstaller_icon",
    format = "ico",
    gray = 113,
)

cross_smoke_bundle(
    name = "cross_build_smoke_bundle",
    app = ":smoke_app",
    linux_packages = ":linux_release_files",
    windows_packages = ":windows_release_files",
)

electron_asar(
    name = "shared_archive",
    srcs = {
        "additional-archive.cjs": "index.cjs",
        ":native_addon": "addon.node",
        "resources/NOTICE.txt": "notice.txt",
    },
    file_matcher = ":file_matcher",
    symlinks = {
        "entry.cjs": "index.cjs",
        "entry-chain.cjs": "entry.cjs",
        "addon-link.node": "addon.node",
    },
    unpacked = [
        "notice.txt",
    ],
    unpacked_patterns = ["**/*.node"],
)

electron_archive(
    name = "release_zip",
    app = ":app",
    compression_level = 1,
)

electron_archive(
    name = "release_7z",
    app = ":app",
    compression_level = 1,
    format = "7z",
    sevenzip = "@sevenzip_linux_x64//:bin/7zz",
)

electron_archive(
    name = "release_tar",
    app = ":app",
    compression_level = 1,
    format = "tar.gz",
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "smoke_app",
    actual = select({
        ":macos": ":release_zip",
        "//conditions:default": ":app",
    }),
)

exports_files([
    "bootstrap_runtime.BUILD.bazel",
    "node_api.BUILD.bazel",
    "updater-package-lock.json",
    "windows-tools-package-lock.json",
    "matcher-tools-package-lock.json",
])

electron_file_matcher(
    name = "file_matcher",
    modules = "@matcher_tools_npm//:runtime",
    node = "@nodejs_26_13_0//:node",
)

filegroup(
    name = "file_matcher_node",
    srcs = [":file_matcher"],
    output_group = "node",
    visibility = ["//tools:__pkg__"],
)

electron_windows_resource_tool(
    name = "windows_resource_tool",
    modules = "@windows_tools_npm//:runtime",
    node = "@nodejs_26_13_0//:node",
)

[
    config_setting(
        name = name,
        constraint_values = [
            "@platforms//os:" + os,
            "@platforms//cpu:" + cpu,
        ],
    )
    for name, os, cpu in [
        ("linux_x64", "linux", "x86_64"),
        ("linux_arm64", "linux", "aarch64"),
        ("macos_arm64", "osx", "aarch64"),
        ("windows_x64", "windows", "x86_64"),
        ("windows_arm64", "windows", "aarch64"),
    ]
]

config_setting(
    name = "windows",
    constraint_values = ["@platforms//os:windows"],
)

config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:osx"],
)

electron_runtime(
    name = "archive_runtime",
    archive = select({
        ":macos_arm64": "@bootstrap_electron_macos_arm64//file",
        ":windows_x64": "@bootstrap_electron_windows_x64//file",
        ":windows_arm64": "@bootstrap_electron_windows_arm64//file",
    }),
    languages = ["en-US"],
    target_compatible_with = select({
        ":macos": [],
        ":windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

alias(
    name = "runtime",
    actual = select({
        ":linux_x64": "@bootstrap_electron_linux_x64//:runtime",
        ":linux_arm64": "@bootstrap_electron_linux_arm64//:runtime",
        ":macos_arm64": ":archive_runtime",
        ":windows_x64": ":archive_runtime",
        ":windows_arm64": ":archive_runtime",
    }),
)

cc_binary(
    name = "helper",
    srcs = ["native/helper.cc"],
)

copy_to_directory(
    name = "renderer_bundle",
    srcs = [
        "renderer/development.map",
        "renderer/development.txt",
        "renderer/index.html",
        "renderer/index.js",
        "renderer/style.css",
    ],
    root_paths = ["renderer"],
)

electron_files(
    name = "renderer_files",
    srcs = {":renderer_bundle": "renderer"},
    directories = ["renderer/empty"],
    file_matcher = ":file_matcher",
    patterns = [
        "**/*",
        "!**/*.map",
        "!**/development.txt",
    ],
)

cc_binary(
    name = "addon.node",
    srcs = ["native/addon.c"],
    linkopts = select({
        ":macos": ["-Wl,-undefined,dynamic_lookup"],
        "//conditions:default": [],
    }),
    linkshared = True,
    target_compatible_with = select({
        ":windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["@node_api_headers//:headers"],
)

cc_binary(
    name = "addon.dll",
    srcs = ["native/addon.c"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@node_api_headers//:headers",
    ],
)

alias(
    name = "native_addon",
    actual = select({
        ":windows": ":addon.dll",
        "//conditions:default": ":addon.node",
    }),
)

desktop_app(
    name = "app",
    package_json = "package.json",
)

desktop_app(
    name = "app_v2",
    package_json = "package-v2.json",
    target_compatible_with = select({
        ":macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)

electron_nsis_tool(
    name = "nsis_tool",
    archive_compiler = "@sevenzip_linux_x64//:bin/7zz",
    compiler = "@nsis_linux_x64//:linux/x64/makensis",
    data = "@nsis_linux_x64//:data",
)

[
    electron_nsis(
        name = name,
        app = app,
        desktop_shortcut = True,
        file_association_icons = {".rules-electron-sample": "resources/document.ico"},
        file_associations = {
            ".rules-electron-sample": "Sample Document",
            ".rules-electron-cleanup": "Sample Cleanup Document",
        },
        installer_icon = ":example_installer_icon",
        protocols = ["sample-desktop"],
        target_compatible_with = ["@platforms//os:windows"],
        tool = ":nsis_tool",
        uninstaller_icon = ":example_uninstaller_icon",
        updater_cache_name = "sample-desktop-updater",
        verify_reproducible = name == "nsis_v1",
    )
    for name, app in [
        ("nsis_v1", ":app"),
        ("nsis_v2", ":app_v2"),
    ]
]

[
    electron_update_feed(
        name = name,
        architecture = select({
            ":windows_arm64": "arm64",
            "//conditions:default": "x64",
        }),
        artifacts = {installer: filename},
        blockmaps = [filename],
        package_json = manifest,
        platform = "windows",
        release_date = "2026-01-02T03:04:05Z",
        target_compatible_with = ["@platforms//os:windows"],
    )
    for name, installer, filename, manifest in [
        ("nsis_v1_feed", ":nsis_v1", "Sample-1.0.0.exe", "package.json"),
        ("nsis_v2_feed", ":nsis_v2", "Sample-2.0.0.exe", "package-v2.json"),
    ]
]

filegroup(
    name = "windows_release_files",
    srcs = [
        ":msix_probe",
        ":msix_reader",
        ":nsis_v1_feed",
        ":nsis_v2_feed",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)

[
    electron_deb(
        name = name,
        package_name = "rules-electron-sample-desktop",
        app = app,
        depends = [
            "libc6 (>= 2.31)",
            "libgtk-3-0",
            "libnss3",
            "libasound2",
            "libgbm1",
            "desktop-file-utils",
            "shared-mime-info",
            "hicolor-icon-theme",
        ],
        description = "Generic Bazel Electron packaging example",
        file_association_icons = {":document_icon": "application/x-sample-desktop"},
        file_associations = {"application/x-sample-desktop": ["*.sample-desktop"]},
        icons = {"assets/sample.svg": "scalable"},
        maintainer = "Example Maintainers <maintainers@example.invalid>",
        protocols = ["sample-desktop"],
        setuid_sandbox = True,
    )
    for name, app in [
        ("deb_v1", ":app"),
        ("deb_v2", ":app_v2"),
    ]
]

electron_update_feed(
    name = "deb_v2_feed",
    architecture = select({
        ":linux_arm64": "arm64",
        "//conditions:default": "x64",
    }),
    artifacts = {":deb_v2": "Sample-2.0.0.deb"},
    package_json = "package-v2.json",
    platform = "linux",
    release_date = "2026-01-02T03:04:05Z",
    target_compatible_with = ["@platforms//os:linux"],
)

[
    electron_rpm(
        name = name,
        package_name = "rules-electron-sample-desktop",
        app = app,
        description = "Generic Bazel Electron packaging example",
        file_association_icons = {":document_icon": "application/x-sample-desktop"},
        file_associations = {"application/x-sample-desktop": ["*.sample-desktop"]},
        icons = {"assets/sample.svg": "scalable"},
        license = "MIT",
        maintainer = "Example Maintainers <maintainers@example.invalid>",
        protocols = ["sample-desktop"],
        requires = [
            "gtk3",
            "nss",
            "alsa-lib",
            "mesa-libgbm",
            "desktop-file-utils",
            "shared-mime-info",
            "hicolor-icon-theme",
        ],
        setuid_sandbox = True,
        summary = "Sample Desktop",
    )
    for name, app in [
        ("rpm_v1", ":app"),
        ("rpm_v2", ":app_v2"),
    ]
]

electron_update_feed(
    name = "rpm_v2_feed",
    architecture = select({
        ":linux_arm64": "arm64",
        "//conditions:default": "x64",
    }),
    artifacts = {":rpm_v2": "Sample-2.0.0.rpm"},
    package_json = "package-v2.json",
    platform = "linux",
    release_date = "2026-01-02T03:04:05Z",
    target_compatible_with = ["@platforms//os:linux"],
)

[
    electron_appimage(
        name = name,
        app = app,
        file_associations = ["application/x-sample-desktop"],
        icon = "assets/sample.svg",
        protocols = ["sample-desktop"],
        target_compatible_with = ["@platforms//os:linux"],
    )
    for name, app in [
        ("appimage_v1", ":app"),
        ("appimage_v2", ":app_v2"),
    ]
]

electron_update_feed(
    name = "appimage_v2_feed",
    architecture = select({
        ":linux_arm64": "arm64",
        "//conditions:default": "x64",
    }),
    artifacts = {":appimage_v2": "Sample-2.0.0.AppImage"},
    embedded_blockmaps = ["Sample-2.0.0.AppImage"],
    package_json = "package-v2.json",
    platform = "linux",
    release_date = "2026-01-02T03:04:05Z",
    target_compatible_with = ["@platforms//os:linux"],
)

filegroup(
    name = "linux_release_files",
    srcs = [
        ":appimage_v1",
        ":appimage_v2_feed",
        ":deb_v1",
        ":deb_v2_feed",
        ":release_7z",
        ":release_tar",
        ":rpm_v1",
        ":rpm_v2_feed",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

electron_update_config(
    name = "update_config",
    cache_name = "sample-desktop-updater",
    url = "https://updates.example.invalid/sample-desktop/",
)

# Metadata fixture only. No installer execution or installability claim.
electron_update_feed(
    name = "update_smoke_feed",
    architecture = select({
        ":windows_arm64": "arm64",
        ":linux_arm64": "arm64",
        ":macos_arm64": "arm64",
        "//conditions:default": "x64",
    }),
    artifacts = {"assets/message.json": "Sample-2.0.0.zip"},
    blockmaps = ["Sample-2.0.0.zip"],
    package_json = "update-package.json",
    platform = select({
        ":windows": "windows",
        ":macos": "macos",
        "//conditions:default": "linux",
    }),
    release_date = "2026-01-02T03:04:05Z",
)

# Execute only on a matching native OS/CPU host; build actions remain remote.
py_test(
    name = "smoke_test",
    size = "medium",
    srcs = ["//tools:smoke_test.py"],
    args = [
        "$(rootpath :app)",
        "--target-os",
    ] + select({
        ":macos": ["macos"],
        ":windows": ["windows"],
        "//conditions:default": ["linux"],
    }) + ["--target-arch"] + select({
        ":windows_arm64": ["arm64"],
        ":linux_arm64": ["arm64"],
        ":macos_arm64": ["arm64"],
        "//conditions:default": ["x64"],
    }),
    data = [":app"],
    main = "//tools:smoke_test.py",
    tags = [
        "local",
        "manual",
    ],
)

[
    example_icon(
        name = "msix_logo_" + str(size),
        size = size,
        format = "png",
    )
    for size in [
        44,
        150,
        50,
    ]
]

msix_fixture_app(
    name = "msix_probe_app",
    binary = ":helper",
    package_json = "package.json",
    target_compatible_with = ["@platforms//os:windows"],
)

electron_msix(
    name = "msix_probe",
    app = ":msix_probe_app",
    logo_150 = ":msix_logo_150",
    logo_44 = ":msix_logo_44",
    publisher = "CN=Example",
    publisher_display_name = "Example",
    store_logo = ":msix_logo_50",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_binary(
    name = "msix_reader",
    srcs = ["native/msix_reader.cc"],
    linkopts = [
        "ole32.lib",
        "shlwapi.lib",
    ],
    target_compatible_with = ["@platforms//os:windows"],
)
