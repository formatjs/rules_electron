# Self-contained: BB may parse this file again while cleaning up from repo root.
common --incompatible_strict_action_env
common --nosandbox_default_allow_network
common --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common --repo_env=BAZEL_DO_NOT_DETECT_SWIFT_TOOLCHAIN=1
build --@rules_python//python/config_settings:bootstrap_impl=script

build:bb-workflow --build_metadata=ROLE=BB_WORKFLOW
build:bb-workflow --build_metadata=VISIBILITY=PUBLIC
build:bb-workflow --config=rbe
build:rbe --extra_execution_platforms=@rules_electron//platforms:buildbuddy_linux_x86_64
build:rbe --platforms=@rules_electron//platforms:buildbuddy_linux_x86_64
build:rbe --bes_backend=grpcs://formatjs.buildbuddy.io
build:rbe --bes_results_url=https://formatjs.buildbuddy.io/invocation/
build:rbe --remote_cache=grpcs://formatjs.buildbuddy.io
build:rbe --remote_executor=grpcs://formatjs.buildbuddy.io
build:rbe --remote_timeout=10m
build:rbe --remote_download_toplevel
build:rbe --remote_cache_compression
build:rbe --jobs=50
try-import %workspace%/.bazelrc.user

# Use only on hosts licensed for the Visual Studio runtime.
build:msvc-license --repo_env=BAZEL_MSVC_RUNTIME_VISUAL_STUDIO_EULA=1
build:msvc --config=msvc-license
build:msvc --features=-dynamic_link_msvcrt
build:msvc --features=static_link_msvcrt
