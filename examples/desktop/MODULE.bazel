module(name = "desktop_example")

bazel_dep(name = "rules_electron", version = "")
local_path_override(
    module_name = "rules_electron",
    path = "../..",
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "nodejs", version = "0.0.0")
bazel_dep(name = "rules_rs", version = "0.0.86")

archive_override(
    module_name = "nodejs",
    sha256 = "da6fd53f2b14a11b681426702bfee0d275b29924d8d8602019ab45262ece3498",
    strip_prefix = "nodejs-a3fe5d39729df187d781271e0605d52955c4b484",
    urls = ["https://github.com/hermeticbuild/nodejs/archive/a3fe5d39729df187d781271e0605d52955c4b484.tar.gz"],
)

nodejs = use_extension("@nodejs//nodejs:extensions.bzl", "nodejs")
nodejs.version(version = "26.13.0")
use_repo(nodejs, "nodejs_26_13_0", "nodejs_crates_26_13_0", "nodejs_icu_26_13_0", "nodejs_toolchains", "v8")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.92.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

nodejs_crates = use_extension("@rules_rs//rs:extensions.bzl", "crate")
nodejs_crates.from_cargo(
    name = "nodejs_crates",
    cargo_lock = "@nodejs_crates_26_13_0//:Cargo.lock",
    cargo_toml = "@nodejs_crates_26_13_0//:Cargo.toml",
    platform_triples = ["x86_64-unknown-linux-gnu"],
    use_legacy_rules_rust_platforms = True,
)
use_repo(nodejs_crates, "nodejs_crates")

inject_repo(nodejs, "nodejs_crates")

register_toolchains("@llvm//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

npm_runtime = use_repo_rule("@rules_electron//electron:npm.bzl", "npm_runtime")

npm_runtime(
    name = "updater_npm",
    lock = "//:updater-package-lock.json",
)

npm_runtime(
    name = "windows_tools_npm",
    lock = "//:windows-tools-package-lock.json",
    strip_node_modules = False,
)

npm_runtime(
    name = "matcher_tools_npm",
    lock = "//:matcher-tools-package-lock.json",
    strip_node_modules = False,
)

http_file(
    name = "bootstrap_electron_macos_arm64",
    downloaded_file_path = "electron.zip",
    sha256 = "678e51190e5b29af4eb5842d4724db35409efb706ce17b1a40faf823720a9c70",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-darwin-arm64.zip"],
)

http_file(
    name = "bootstrap_electron_windows_x64",
    downloaded_file_path = "electron.zip",
    sha256 = "bdcf82b95100a4b770dded1587d8d9dafddf782079127a8dbdc1891faef324a5",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-win32-x64.zip"],
)

http_file(
    name = "bootstrap_electron_windows_arm64",
    downloaded_file_path = "electron.zip",
    sha256 = "31fe7805a77c2c6accfede1c954fc4a3f43816e7c921a11cf8f34f57da7f40dc",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-win32-arm64.zip"],
)

# Linux execution tool; macOS target binaries never execute during assembly.
http_archive(
    name = "sevenzip_linux_x64",
    build_file_content = "exports_files([\"bin/7zz\"])\n",
    sha256 = "98ac470cf076f19241b5ee259e135de0adc3c3b8076c41682d6468c2a9990845",
    strip_prefix = "7zip",
    urls = ["https://github.com/electron-userland/electron-builder-binaries/releases/download/7zip%401.1.0/7zip-linux-x64.tar.gz"],
)

http_archive(
    name = "nsis_linux_x64",
    build_file_content = """load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
exports_files(["linux/x64/makensis"])
copy_to_directory(
    name = "data",
    srcs = glob(["windows/Include/**", "windows/Contrib/**", "windows/Stubs/**", "windows/Plugins/**"]),
    root_paths = ["windows"],
    include_external_repositories = ["*"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "c18e9ad9684cf4c5bbd7b768cbf1b056d40771d7bd9ae1b513346452decf89d2",
    strip_prefix = "nsis-bundle",
    urls = ["https://github.com/electron-userland/electron-builder-binaries/releases/download/nsis%402.0.4/nsis-bundle-3.13.tar.gz"],
)

http_archive(
    name = "rcodesign_linux_x64",
    build_file_content = "exports_files([\"rcodesign\"])\n",
    sha256 = "dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002",
    strip_prefix = "apple-codesign-0.29.0-x86_64-unknown-linux-musl",
    urls = ["https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign%2F0.29.0/apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz"],
)

