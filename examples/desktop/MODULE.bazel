module(name = "desktop_example")

bazel_dep(name = "rules_electron", version = "")
local_path_override(
    module_name = "rules_electron",
    path = "../..",
)

bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

register_toolchains("@llvm//toolchain:all")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

http_file(
    name = "bootstrap_electron_macos_arm64",
    downloaded_file_path = "electron.zip",
    sha256 = "678e51190e5b29af4eb5842d4724db35409efb706ce17b1a40faf823720a9c70",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-darwin-arm64.zip"],
)

http_file(
    name = "bootstrap_electron_windows_x64",
    downloaded_file_path = "electron.zip",
    sha256 = "bdcf82b95100a4b770dded1587d8d9dafddf782079127a8dbdc1891faef324a5",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-win32-x64.zip"],
)

http_file(
    name = "bootstrap_electron_windows_arm64",
    downloaded_file_path = "electron.zip",
    sha256 = "31fe7805a77c2c6accfede1c954fc4a3f43816e7c921a11cf8f34f57da7f40dc",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-win32-arm64.zip"],
)

# Linux execution tool; macOS target binaries never execute during assembly.
http_archive(
    name = "rcodesign_linux_x64",
    build_file_content = "exports_files([\"rcodesign\"])\n",
    sha256 = "dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002",
    strip_prefix = "apple-codesign-0.29.0-x86_64-unknown-linux-musl",
    urls = ["https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign%2F0.29.0/apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz"],
)

# Temporary example-only bootstrap. Replace :runtime with source-built outputs.
http_archive(
    name = "bootstrap_electron_linux_x64",
    build_file = "//:bootstrap_runtime.BUILD.bazel",
    sha256 = "4520cbd92eeed370d7cfd2b1c60135647c02b8f634d6179d8a9a3f64b64baf2f",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-linux-x64.zip"],
)

http_archive(
    name = "bootstrap_electron_linux_arm64",
    build_file = "//:bootstrap_runtime.BUILD.bazel",
    sha256 = "8985a9b2055c17f2bdae4418af140d6accd12b28f929319f5a918ca79b0a3d43",
    urls = ["https://github.com/electron/electron/releases/download/v39.0.0/electron-v39.0.0-linux-arm64.zip"],
)

# This addon uses stable Node-API, not Node/V8 internals or node-gyp.
http_archive(
    name = "node_api_headers",
    build_file = "//:node_api.BUILD.bazel",
    sha256 = "22ba4692576442821f70156219752835a920e9ea2c0113a50fd9ebecb0ea6bbd",
    strip_prefix = "node-v22.20.0/include/node",
    urls = ["https://nodejs.org/dist/v22.20.0/node-v22.20.0-headers.tar.gz"],
