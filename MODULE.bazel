module(
    name = "rules_electron",
    version = "",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")
bazel_dep(name = "zlib", version = "1.3.1.bcr.9")
bazel_dep(name = "zstd", version = "1.5.7.bcr.3")
bazel_dep(name = "mimalloc", version = "3.5.3")
bazel_dep(name = "openssl", version = "3.5.9.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "llvm", version = "0.8.26")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

npm_runtime = use_repo_rule("//electron:npm.bzl", "npm_runtime")

npm_runtime(
    name = "bundled_npm_fixture",
    dev_dependency = True,
    lock = "//tests:fixtures/bundled-package-lock.json",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

