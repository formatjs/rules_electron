module(
    name = "rules_electron",
    version = "",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_pkg", version = "1.1.0")

bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

npm_runtime = use_repo_rule("//electron:npm.bzl", "npm_runtime")

npm_runtime(
    name = "bundled_npm_fixture",
    dev_dependency = True,
    lock = "//tests:fixtures/bundled-package-lock.json",
)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sevenzip_linux_x64",
    build_file_content = "exports_files([\"bin/7zz\"])\n",
    dev_dependency = True,
    sha256 = "98ac470cf076f19241b5ee259e135de0adc3c3b8076c41682d6468c2a9990845",
    strip_prefix = "7zip",
    urls = ["https://github.com/electron-userland/electron-builder-binaries/releases/download/7zip%401.1.0/7zip-linux-x64.tar.gz"],
)
