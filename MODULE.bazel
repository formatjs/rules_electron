source_overlay = use_repo_rule("//tools/ci:source_overlay_repository.bzl", "electron_source_overlay")

source_overlay(name = "electron_source_overlay")

bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

