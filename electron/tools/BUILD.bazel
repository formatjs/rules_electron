load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//electron/private:release_backend.bzl", "release_backend")
load("//third_party:appimage_runtime.bzl", "static_pie_runtime")

package(default_visibility = ["//visibility:public"])

exports_files([
    "notarize_macos.py",
    "sign_macos.py",
])

py_library(
    name = "macos_release",
    srcs = ["sign_macos.py"],
    deps = [
        ":notarization",
        "//electron/private:assembly",
    ],
)

py_library(
    name = "notarization",
    srcs = ["notarize_macos.py"],
    deps = [
        "//electron/private:archives",
        "//electron/private:assembly",
        "@rules_python//python/runfiles",
    ],
)

config_setting(
    name = "windows_msvc",
    constraint_values = ["@llvm//constraints/windows/abi:msvc"],
)

cc_binary(
    name = "windows_elevate",
    srcs = ["windows_elevate.cc"],
    copts = select({
        ":windows_msvc": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    linkopts = select({
        ":windows_msvc": [
            "shell32.lib",
            "ole32.lib",
            "/subsystem:windows",
            "/entry:mainCRTStartup",
        ],
        "//conditions:default": [
            "-lshell32",
            "-lole32",
            "-mwindows",
        ],
    }),
    target_compatible_with = ["@platforms//os:windows"],
)

release_backend(
    name = "windows_signing_backend",
    tool = ":osslsigncode",
)

py_binary(
    name = "sign_windows",
    srcs = ["sign_windows.py"],
    data = [":windows_signing_backend"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@rules_python//python/runfiles"],
)

py_library(
    name = "publication",
    srcs = ["publish_update.py"],
    deps = ["//electron/private:updates"],
)

py_binary(
    name = "publish_update",
    srcs = ["publish_update.py"],
    main = "publish_update.py",
    deps = ["//electron/private:updates"],
)

alias(
    name = "mksquashfs",
    actual = "@appimage_squashfs_sources//:mksquashfs",
)

alias(
    name = "unsquashfs",
    actual = "@appimage_squashfs_sources//:unsquashfs",
)

alias(
    name = "appimage_runtime",
    actual = "@appimage_runtime_sources//:runtime",
)

static_pie_runtime(
    name = "appimage_apprun",
    srcs = ["appimage_apprun.c"],
    copts = [
        "-std=gnu11",
        "-fPIE",
    ],
    features = ["fully_static_link"],
    linkopts = ["-static-pie"],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "osslsigncode",
    actual = "@osslsigncode_sources//:osslsigncode",
)
