# Shared BuildBuddy service; credentials supplied by the CI wrapper.
build:bb-workflow --build_metadata=ROLE=BB_WORKFLOW
build:bb-workflow --build_metadata=VISIBILITY=PUBLIC
build:bb-workflow --config=rbe

build:rbe --extra_execution_platforms=@rules_electron//platforms:buildbuddy_linux_x86_64
build:rbe --platforms=@rules_electron//platforms:buildbuddy_linux_x86_64
build:rbe --bes_backend=grpcs://remote.buildbuddy.io
build:rbe --bes_results_url=https://app.buildbuddy.io/invocation/
build:rbe --bes_upload_mode=wait_for_upload_complete
build:rbe --noremote_upload_local_results
build:rbe --build_metadata=REPO_URL=https://github.com/perplexityai/rules_electron.git
build:rbe --remote_cache=grpcs://remote.buildbuddy.io
build:rbe --remote_executor=grpcs://remote.buildbuddy.io
build:rbe --remote_timeout=10m
build:rbe --remote_download_toplevel
build:rbe --remote_cache_compression
build:rbe --jobs=50
