load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_electron//third_party:squashfuse.bzl", "squashfuse_swap")

package(default_visibility = ["//visibility:public"])

squashfuse_swap(
    name = "swap_includes",
    header = "squashfs_fs.h",
    upstream = "gen_swap.sh",
)

cc_library(
    name = "squashfuse",
    srcs = [source + ".c" for source in [
        "swap",
        "cache",
        "table",
        "dir",
        "file",
        "fs",
        "decompress",
        "xattr",
        "hash",
        "stack",
        "traverse",
        "util",
        "nonstd-pread",
        "nonstd-stat",
        "cache_mt",
        "fuseprivate",
        "nonstd-makedev",
        "nonstd-enoattr",
        "stat",
        "ll",
        "ll_inode",
        "nonstd-daemon",
    ]],
    hdrs = glob(["*.h"]) + [":swap_includes"],
    copts = ["-std=gnu11"],
    include_prefix = "squashfuse",
    includes = ["."],
    local_defines = [
        "_GNU_SOURCE",
        "_FILE_OFFSET_BITS=64",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "@appimage_fuse3_sources//:fuse3",
        "@zlib",
        "@zstd",
    ],
)

exports_files(["LICENSE"])
