 #define SECTORS_AT_A_TIME 0x200 // 512
 #define SECTOR_SIZE 512
 
+#define COMPRESSION_WORKERS 4
+
+typedef struct {
+  unsigned char *input;
+  unsigned char *output;
+  size_t bufferSize;
+  size_t outputSize;
+  uint32_t sectors;
+  int result;
+  int started;
+  pthread_t thread;
+} CompressionJob;
+
+static void *compressRun(void *argument) {
+  CompressionJob *job = (CompressionJob *)argument;
+  z_stream stream;
+  memset(&stream, 0, sizeof(stream));
+  job->result = deflateInit(&stream, Z_DEFAULT_COMPRESSION);
+  if (job->result != Z_OK)
+    return NULL;
+  stream.avail_in = job->sectors * SECTOR_SIZE;
+  stream.next_in = job->input;
+  stream.avail_out = job->bufferSize;
+  stream.next_out = job->output;
+  job->result = deflate(&stream, Z_FINISH);
+  job->outputSize = job->bufferSize - stream.avail_out;
+  deflateEnd(&stream);
+  return NULL;
+}
+
