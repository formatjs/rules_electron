"""Native UDIF conversion from the original source units."""

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

cc_binary(
    name = "dmg",
    srcs = glob([
        "dmg/*.c",
        "includes/*.h",
    ]),
    copts = ["-std=gnu11"],
    defines = [
        "_FILE_OFFSET_BITS=64",
        "_GNU_SOURCE",
    ],
    includes = ["includes"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["@zlib"],
)
