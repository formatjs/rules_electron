load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "fuse3",
    srcs = ["lib/" + source for source in [
        "fuse.c",
        "fuse_loop.c",
        "fuse_loop_mt.c",
        "fuse_lowlevel.c",
        "fuse_opt.c",
        "fuse_signals.c",
        "buffer.c",
        "cuse_lowlevel.c",
        "helper.c",
        "modules/subdir.c",
        "modules/iconv.c",
        "mount_util.c",
        "fuse_log.c",
        "compat.c",
        "mount.c",
    ]],
    hdrs = glob([
        "include/*.h",
        "lib/*.h",
    ]) + ["fuse_config.h"],
    copts = [
        "-std=gnu11",
        "-fno-strict-aliasing",
    ],
    includes = [
        ".",
        "include",
    ],
    linkopts = [
        "-pthread",
        "-ldl",
        "-lrt",
    ],
    local_defines = [
        "_FILE_OFFSET_BITS=64",
        "_GNU_SOURCE",
        "_REENTRANT",
        "FUSE_USE_VERSION=312",
        "HAVE_LIBFUSE_PRIVATE_CONFIG_H",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

exports_files([
    "LICENSE",
    "LGPL2.txt",
])
