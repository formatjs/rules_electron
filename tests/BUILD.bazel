load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//electron:defs.bzl", "electron_app", "electron_runtime")
load(":cross_build.bzl", "cross_build")

cross_build(
    name = "cross_build_fixtures",
    app = ":app",
    probe = ":runtime_probe",
    tags = ["manual"],
)

py_test(
    name = "nsis_test",
    size = "small",
    srcs = ["nsis_test.py"],
    deps = ["//electron/private:nsis"],
)

py_test(
    name = "profile_test",
    size = "small",
    srcs = ["profile_test.py"],
    deps = ["//tools/ci:profiles"],
)

py_test(
    name = "hermetic_execution_test",
    size = "small",
    srcs = ["hermetic_execution_test.py"],
    tags = [
        "external",
        "no-cache",
    ],
)

py_test(
    name = "linux_package_test",
    size = "small",
    srcs = ["linux_package_test.py"],
    deps = ["//electron/private:linux_packaging"],
)

py_test(
    name = "update_test",
    size = "small",
    srcs = ["update_test.py"],
    deps = ["//electron/private:updates"],
)

py_test(
    name = "artifact_handoff_test",
    size = "small",
    srcs = ["artifact_handoff_test.py"],
    deps = ["//tools/ci:artifacts"],
)

py_test(
    name = "platform_layout_test",
    size = "small",
    srcs = ["platform_layout_test.py"],
    deps = ["//electron/private:assembly"],
)

cc_binary(
    name = "runtime_probe",
    srcs = ["fixtures/runtime.cc"],
)

electron_runtime(
    name = "runtime",
    binary = ":runtime_probe",
    files = {"fixtures/icudtl.dat": "icudtl.dat"},
)

electron_app(
    name = "app",
    srcs = {"fixtures/main.js": "main.js"},
    package_json = "fixtures/package.json",
    runtime = ":runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "assembly_test",
    size = "small",
    srcs = ["assembly_test.py"],
    deps = ["//electron/private:assembly"],
)

py_test(
    name = "fuses_test",
    size = "small",
    srcs = ["fuses_test.py"],
    deps = ["//electron/private:assembly"],
)

py_test(
    name = "relocation_test",
    size = "small",
    srcs = ["relocation_test.py"],
    args = ["$(rootpath :app)"],
    data = [":app"],
    target_compatible_with = ["@platforms//os:linux"],
)
