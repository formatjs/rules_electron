load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_python//python:defs.bzl", "py_test")
load("//electron:archive.bzl", "electron_archive")
load("//electron:defs.bzl", "electron_app", "electron_runtime")
load("//electron:metadata.bzl", "electron_package_json")
load(":cross_build.bzl", "cross_build")

py_test(
    name = "smoke_bundle_test",
    size = "small",
    srcs = ["smoke_bundle_test.py"],
    deps = [
        "//tools/ci:artifacts",
        "//tools/ci:smoke_bundling",
    ],
)

electron_archive(
    name = "release_zip",
    app = ":app",
)

electron_archive(
    name = "release_tar",
    app = ":app",
    format = "tar.gz",
)

py_test(
    name = "archive_test",
    size = "small",
    srcs = ["archive_test.py"],
    args = [
        "$(rootpath :release_zip)",
        "$(rootpath :release_tar)",
    ],
    data = [
        ":release_tar",
        ":release_zip",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["//electron/private:archives"],
)

cross_build(
    name = "cross_build_fixtures",
    app = ":app",
    probe = ":runtime_probe",
    tags = ["manual"],
)

py_test(
    name = "nsis_test",
    size = "small",
    srcs = ["nsis_test.py"],
    deps = ["//electron/private:nsis"],
)

py_test(
    name = "profile_test",
    size = "small",
    srcs = ["profile_test.py"],
    deps = ["//tools/ci:profiles"],
)

py_test(
    name = "hermetic_execution_test",
    size = "small",
    srcs = ["hermetic_execution_test.py"],
    tags = [
        "external",
        "no-cache",
    ],
)

py_test(
    name = "linux_package_test",
    size = "small",
    srcs = ["linux_package_test.py"],
    deps = ["//electron/private:linux_packaging"],
)

py_test(
    name = "update_test",
    size = "small",
    srcs = ["update_test.py"],
    deps = ["//electron/private:updates"],
)

py_test(
    name = "artifact_handoff_test",
    size = "small",
    srcs = ["artifact_handoff_test.py"],
    deps = ["//tools/ci:artifacts"],
)

py_test(
    name = "platform_layout_test",
    size = "small",
    srcs = ["platform_layout_test.py"],
    deps = ["//electron/private:assembly"],
)

cc_binary(
    name = "runtime_probe",
    srcs = ["fixtures/runtime.cc"],
)

electron_runtime(
    name = "runtime",
    binary = ":runtime_probe",
    files = {"fixtures/icudtl.dat": "icudtl.dat"},
)

electron_app(
    name = "app",
    srcs = {"fixtures/main.js": "main.js"},
    package_json = "fixtures/package.json",
    runtime = ":runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "assembly_test",
    size = "small",
    srcs = ["assembly_test.py"],
    deps = ["//electron/private:assembly"],
)

py_test(
    name = "fuses_test",
    size = "small",
    srcs = ["fuses_test.py"],
    deps = ["//electron/private:assembly"],
)

py_test(
    name = "relocation_test",
    size = "small",
    srcs = ["relocation_test.py"],
    args = ["$(rootpath :app)"],
    data = [":app"],
    target_compatible_with = ["@platforms//os:linux"],
)

electron_package_json(
    name = "package_identity",
    src = "fixtures/package.json",
    version = "3.2.1-beta.2+build.7",
)

electron_app(
    name = "versioned_app",
    srcs = {"fixtures/main.js": "main.js"},
    build_number = "7",
    package_json = ":package_identity",
    runtime = ":runtime",
    target_compatible_with = ["@platforms//os:linux"],
)

py_test(
    name = "identity_test",
    size = "small",
    srcs = ["identity_test.py"],
    args = [
        "$(rootpath :package_identity)",
        "$(rootpath :versioned_app)",
    ],
    data = [
        ":package_identity",
        ":versioned_app",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//electron/private:identity",
        "//electron/private:updates",
    ],
)
